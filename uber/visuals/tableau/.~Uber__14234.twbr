      <column caption='CashPayment' datatype='real' name='[Calculation_1001628752495382530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [pay_method] = &apos;Cash&apos; THEN 1 ELSE 0 END) / COUNT([pay_method])) * 100' />
      </column>
      <column caption='DigitalPayment' datatype='real' name='[Calculation_1001628752495570947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [pay_method] != &apos;Cash&apos; THEN 1 ELSE 0 END) / COUNT([pay_method])) * 100' />
      </column>
      <column caption='Complete Ride' datatype='integer' name='[Calculation_368310053810737154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [incomplete_rides] = 0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='weekday' datatype='string' name='[Calculation_638385293979787266]' role='dimension' type='nominal'>
